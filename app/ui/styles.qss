/* Academic AI — student workspace theme */

QMainWindow,
QWidget {
    background-color: #F4F7FB;
    color: #102A43;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* Labels inherit the page colour; without this they paint a light box over
   dark surfaces (sidebar) and white cards. */
QLabel {
    background: transparent;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Sidebar */
QFrame#Sidebar {
    background-color: #102A43;
    border: none;
}

QFrame#Brand {
    background: transparent;
}

QLabel#BrandTitle {
    color: #FFFFFF;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: 0.3px;
}

QLabel#BrandSubtitle {
    color: #9FB3C8;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #C9D6E3;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 6px;
    padding: 11px 14px;
    text-align: left;
    font-weight: 600;
    font-size: 13px;
}

QPushButton#NavButton:hover {
    background-color: #183B56;
    color: #FFFFFF;
}

QPushButton#NavButton:checked {
    background-color: #1B4A73;
    border-left: 3px solid #5AA9FF;
    color: #FFFFFF;
}

QFrame#SidebarUser {
    background-color: #183B56;
    border: 1px solid #24537A;
    border-radius: 8px;
}

QLabel#SidebarUserName {
    color: #FFFFFF;
    font-weight: 700;
}

QLabel#SidebarUserMeta {
    color: #9FB3C8;
    font-size: 11px;
}

/* Typography */
QLabel#PageTitle {
    color: #102A43;
    font-size: 26px;
    font-weight: 800;
}

QLabel#PageSubtitle {
    color: #627D98;
    font-size: 13px;
}

QLabel#SectionTitle {
    color: #102A43;
    font-size: 17px;
    font-weight: 700;
}

QLabel#CardTitle {
    color: #102A43;
    font-size: 15px;
    font-weight: 700;
}

QLabel#Muted {
    color: #627D98;
    font-size: 12px;
}

QLabel#FieldLabel {
    color: #829AB1;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

QLabel#StatLabel {
    color: #829AB1;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
}

QLabel#StatValue {
    color: #102A43;
    font-size: 23px;
    font-weight: 800;
}

QLabel#EmptyState {
    color: #627D98;
    font-size: 13px;
    padding: 26px;
}

/* Cards */
QFrame#Card,
QFrame[class="Card"],
QFrame#CourseCard,
QFrame#AuthCard,
QFrame#ConnectionBar,
QFrame#StatCard,
QFrame#ProfileChip {
    background-color: #FFFFFF;
    border: 1px solid #D9E2EC;
    border-radius: 10px;
}

QFrame#AuthCard {
    background-color: #EAF3FF;
    border: 1px solid #B6D4FE;
}

QFrame#ConnectionBar {
    background-color: #ECFDF5;
    border: 1px solid #A7F3D0;
}

QFrame#CourseCard:hover {
    border: 1px solid #2F80ED;
    background-color: #F8FBFF;
}

QFrame#ProfileChip {
    background-color: #FFFFFF;
}

QLabel#Avatar {
    background-color: #1B4A73;
    color: #FFFFFF;
    border-radius: 18px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    font-weight: 800;
    font-size: 12px;
}

QLabel#ProfileName {
    color: #102A43;
    font-weight: 700;
}

QLabel#CourseCardTitle {
    color: #102A43;
    font-size: 16px;
    font-weight: 700;
}

QLabel#Pill {
    background-color: #E6F0FA;
    color: #1B4A73;
    border-radius: 10px;
    padding: 3px 9px;
    font-size: 10px;
    font-weight: 700;
}

QLabel#StatusDot {
    color: #0E9F6E;
    font-size: 14px;
}

QLabel#ConnectionLabel {
    color: #065F46;
    font-weight: 600;
}

/* Buttons */
QPushButton {
    border-radius: 7px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton#PrimaryButton {
    background-color: #0F6CBD;
    color: #FFFFFF;
    border: 1px solid #0F6CBD;
    padding: 9px 18px;
}

QPushButton#PrimaryButton:hover {
    background-color: #115EA3;
    border-color: #115EA3;
}

QPushButton#PrimaryButton:pressed {
    background-color: #0B4F8A;
}

QPushButton#PrimaryButton:disabled {
    background-color: #B6D4FE;
    border-color: #B6D4FE;
    color: #FFFFFF;
}

QPushButton#SecondaryButton {
    background-color: #FFFFFF;
    color: #1B4A73;
    border: 1px solid #BCCCDC;
}

QPushButton#SecondaryButton:hover {
    background-color: #F0F4F8;
    border-color: #829AB1;
}

QPushButton#GhostButton {
    background-color: transparent;
    color: #0F6CBD;
    border: 1px solid transparent;
    padding: 7px 10px;
}

QPushButton#GhostButton:hover {
    background-color: #EAF3FF;
    border-color: #B6D4FE;
}

QPushButton#DangerButton {
    background-color: #DC2626;
    color: #FFFFFF;
    border: 1px solid #DC2626;
}

QPushButton#DangerButton:hover {
    background-color: #B91C1C;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QDateEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #BCCCDC;
    border-radius: 7px;
    padding: 8px 11px;
    color: #102A43;
    selection-background-color: #B6D4FE;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #0F6CBD;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D9E2EC;
    selection-background-color: #EAF3FF;
    selection-color: #102A43;
    padding: 4px;
}

QCheckBox {
    background: transparent;
    spacing: 8px;
    color: #334E68;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #829AB1;
    background: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #0F6CBD;
    border-color: #0F6CBD;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #D9E2EC;
    border-radius: 10px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #627D98;
    padding: 9px 16px;
    margin-right: 4px;
    border-bottom: 2px solid transparent;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #0F6CBD;
    border-bottom: 2px solid #0F6CBD;
}

QTabBar::tab:hover {
    color: #102A43;
}

/* Lists and tables */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #D9E2EC;
    border-radius: 8px;
    padding: 4px;
}

QListWidget::item {
    padding: 9px 10px;
    border-radius: 6px;
}

QListWidget::item:selected {
    background-color: #EAF3FF;
    color: #102A43;
}

QListWidget::item:hover {
    background-color: #F5F9FF;
}

QListWidget#AssignmentList::item {
    padding: 10px 11px;
    border-bottom: 1px solid #F0F4F8;
}

QListWidget#AssignmentList::item:selected {
    background-color: #EAF3FF;
    color: #102A43;
}

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FFFFFF;
    border: 1px solid #D9E2EC;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: #EAF3FF;
    selection-color: #102A43;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #627D98;
    padding: 9px 8px;
    border: none;
    border-bottom: 1px solid #D9E2EC;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
}

QTableWidget::item {
    padding: 8px;
}

/* Progress */
QProgressBar {
    border: 1px solid #D9E2EC;
    border-radius: 7px;
    text-align: center;
    background-color: #EAF0F6;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #0F6CBD;
    border-radius: 6px;
}

/* Badges */
QLabel#BadgePass {
    background-color: #D1FAE5;
    color: #065F46;
    border-radius: 6px;
    padding: 5px 10px;
    font-weight: 700;
}

QLabel#BadgeWarning {
    background-color: #FEF3C7;
    color: #92400E;
    border-radius: 6px;
    padding: 5px 10px;
    font-weight: 700;
}

QLabel#BadgeFail {
    background-color: #FEE2E2;
    color: #991B1B;
    border-radius: 6px;
    padding: 5px 10px;
    font-weight: 700;
}

/* Scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #BCCCDC;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #829AB1;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #BCCCDC;
    border-radius: 4px;
    min-width: 28px;
}

QToolTip {
    background-color: #102A43;
    color: #FFFFFF;
    border: none;
    padding: 5px 8px;
    border-radius: 5px;
}
