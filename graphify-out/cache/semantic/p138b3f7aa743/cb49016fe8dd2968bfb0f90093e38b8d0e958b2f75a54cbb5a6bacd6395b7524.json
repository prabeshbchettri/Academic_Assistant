{"nodes": [{"id": "docs_05_ai_engineering_architecture_design_principle", "label": "Deterministic-First Design Principle", "file_type": "rationale", "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:3-14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The LLM is used only for classification, drafting, and rubric evaluation; everything computable or validatable deterministically (normalization, hashing, word counts, required-section checks, arithmetic, LaTeX escaping, parsing, layout) is done in Python. Chosen because it reduces cost, variance, and hallucination surface for a document-generation product."}, {"id": "docs_05_ai_engineering_architecture_llmprovider", "label": "LLMProvider Protocol", "file_type": "concept", "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:16-47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_05_ai_engineering_architecture_geminiprovider", "label": "GeminiProvider", "file_type": "concept", "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:49-66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses google.genai.Client with v1beta, 60s timeout, JSON response mime type, Pydantic response_schema, and a hardcoded model fallback list [primary, fallback, gemini-2.5-flash, gemini-2.5-flash-lite] to survive model unavailability."}, {"id": "docs_05_ai_engineering_architecture_mockprovider", "label": "MockProvider", "file_type": "concept", "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:68-77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic offline provider with keyword classification, sample section body, force_pass evaluation, and SHA-256-derived 768-dim pseudo-embeddings. Excellent for unit tests and offline demos, but RAG evaluations run against it measure plumbing, not retrieval quality."}, {"id": "docs_05_ai_engineering_architecture_sectiongenerator", "label": "SectionGenerator", "file_type": "concept", "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:98-198", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates sections sequentially, each with only a heading+word-count summary of prior sections rather than their full text; this limits context growth but also limits cross-section coherence."}, {"id": "docs_05_ai_engineering_architecture_evaluator", "label": "Evaluator", "file_type": "concept", "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:200-226", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic checks (required sections, word limits, banned phrases, citation keys) run before per-section semantic evaluation. Known limitations: hardcoded overall_score, incomplete deterministic checks, fail-open on exception, no calibration set."}, {"id": "docs_05_ai_engineering_architecture_classifier", "label": "Classifier", "file_type": "concept", "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:144-161", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rule keywords resolve most cases deterministically (final_lab 0.90, initial_lab 0.88, assignment 0.85) and only fall back to an LLM ClassificationResult when no rule matches; manual selection bypasses all of it with confidence 1.0."}, {"id": "docs_05_ai_engineering_architecture_prompt_architecture", "label": "Prompt Architecture", "file_type": "concept", "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:98-142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System/generation/evaluation prompt triplets per category, rendered with Jinja2 from a fixed variable set. Generation prompts are intentionally short and rely on the system prompt plus the schema; system prompts carry the anti-hallucination rules and [[MISSING: ...]] instructions."}, {"id": "docs_05_ai_engineering_architecture_model_config_drift", "label": "Model Configuration Drift", "file_type": "concept", "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:79-96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settings defaults, .env.example, UI choices, and the hardcoded Gemini fallback list are not derived from one source of truth, so model names disagree across the app; GEMINI_PRO_MODEL is declared but unused."}, {"id": "docs_05_ai_engineering_architecture_security_wrapper", "label": "Untrusted-Data Wrapping and Sanitization", "file_type": "concept", "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:284-305", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sanitize_external_input caps length at 100k chars and redacts known injection phrases; wrap_untrusted_data wraps text in a random 16-hex boundary. Generator and classifier use it, but the evaluator does not - a prompt-injection gap."}, {"id": "docs_05_ai_engineering_architecture_rag", "label": "Retrieval-Augmented Generation (RAG)", "file_type": "concept", "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:228-255", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ChromaDB collection per course with 1000-char/150-overlap character chunking. Disabled in all category configs and indexed with MockProvider pseudo-embeddings, so retrieval quality is currently meaningless."}], "edges": [{"source": "docs_05_ai_engineering_architecture_geminiprovider", "target": "docs_05_ai_engineering_architecture_llmprovider", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:41-42", "weight": 1.0}, {"source": "docs_05_ai_engineering_architecture_mockprovider", "target": "docs_05_ai_engineering_architecture_llmprovider", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:41-42", "weight": 1.0}, {"source": "docs_05_ai_engineering_architecture_design_principle", "target": "docs_05_ai_engineering_architecture_sectiongenerator", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:3-14", "weight": 1.0}, {"source": "docs_05_ai_engineering_architecture_sectiongenerator", "target": "docs_05_ai_engineering_architecture_llmprovider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:181", "weight": 1.0}, {"source": "docs_05_ai_engineering_architecture_evaluator", "target": "docs_05_ai_engineering_architecture_llmprovider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:210-212", "weight": 1.0}, {"source": "docs_05_ai_engineering_architecture_classifier", "target": "docs_05_ai_engineering_architecture_llmprovider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:152", "weight": 1.0}, {"source": "docs_05_ai_engineering_architecture_prompt_architecture", "target": "docs_05_ai_engineering_architecture_sectiongenerator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:108-113", "weight": 1.0}, {"source": "docs_05_ai_engineering_architecture_security_wrapper", "target": "docs_05_ai_engineering_architecture_sectiongenerator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:290-292", "weight": 1.0}, {"source": "docs_05_ai_engineering_architecture_security_wrapper", "target": "docs_05_ai_engineering_architecture_evaluator", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:298", "weight": 1.0}, {"source": "docs_05_ai_engineering_architecture_rag", "target": "docs_05_ai_engineering_architecture_llmprovider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:233-239", "weight": 1.0}, {"source": "docs_05_ai_engineering_architecture_model_config_drift", "target": "docs_05_ai_engineering_architecture_geminiprovider", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:91-96", "weight": 1.0}, {"source": "docs_05_ai_engineering_architecture_sectiongenerator", "target": "ai_prompts_assignment_generation_gen_prompt", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/05_AI_ENGINEERING_ARCHITECTURE.md", "source_location": "docs/05_AI_ENGINEERING_ARCHITECTURE.md:104-109", "weight": 1.0}], "hyperedges": []}