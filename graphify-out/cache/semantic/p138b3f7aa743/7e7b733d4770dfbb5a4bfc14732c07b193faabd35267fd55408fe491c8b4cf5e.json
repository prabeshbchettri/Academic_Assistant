{"nodes": [{"id": "docs_10_nvidia_nim_migration_plan_nvidiaprovider", "label": "NvidiaProvider", "file_type": "concept", "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:86-142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Planned ai/llm/nvidia.py implementing LLMProvider over the OpenAI-compatible NIM endpoint, with lazy openai import so offline mode and imports survive a missing package, max_retries=0 because the provider owns fallback, and no hardcoded model IDs."}, {"id": "docs_10_nvidia_nim_migration_plan_structured_output_strategy", "label": "NIM Structured Output Strategy", "file_type": "concept", "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:97-117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tries native response_format json_schema with strict=True first, falls back to a JSON-only instruction plus schema text when the endpoint rejects it, then makes one repair request containing the validation error; this keeps the native fast path for Bolt while giving Lightning a documented path."}, {"id": "docs_10_nvidia_nim_migration_plan_provider_factory", "label": "build_llm_provider Provider Factory", "file_type": "concept", "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:143-155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single selection point returning MockProvider when use_mock or no key is set, otherwise NvidiaProvider; introduced to remove duplicated selection logic and keep RAG indexing on the same embedding model as retrieval."}, {"id": "docs_10_nvidia_nim_migration_plan_model_selection", "label": "NVIDIA NIM Model Selection (Lightning primary, Bolt fallback)", "file_type": "concept", "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:43-82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lightning (30B/3B active, 1M context) is primary because it is production-intended, covers the 100k-char cap plus prompts, and has the strongest reasoning; Bolt (8B/4B, 65,536 context) is fallback because it has the most reliable documented json_schema structured-output path."}, {"id": "docs_10_nvidia_nim_migration_plan_embedding_compatibility", "label": "NVIDIA Embedding Compatibility and Reindex Requirement", "file_type": "concept", "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:246-275", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "nemotron-3.5-embed-1b requires input_type passage for indexing and query for retrieval; using the wrong mode materially reduces accuracy. Migration is safe because RAG is disabled, but enabling it later needs a one-time reindex rather than a schema change."}], "edges": [{"source": "docs_10_nvidia_nim_migration_plan_nvidiaprovider", "target": "docs_05_ai_engineering_architecture_llmprovider", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:88", "weight": 1.0}, {"source": "docs_10_nvidia_nim_migration_plan_nvidiaprovider", "target": "docs_10_nvidia_nim_migration_plan_structured_output_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:99-117", "weight": 1.0}, {"source": "docs_10_nvidia_nim_migration_plan_provider_factory", "target": "docs_10_nvidia_nim_migration_plan_nvidiaprovider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:147-152", "weight": 1.0}, {"source": "docs_10_nvidia_nim_migration_plan_provider_factory", "target": "docs_05_ai_engineering_architecture_mockprovider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:148-151", "weight": 1.0}, {"source": "docs_10_nvidia_nim_migration_plan_model_selection", "target": "docs_10_nvidia_nim_migration_plan_nvidiaprovider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:59-63", "weight": 1.0}, {"source": "docs_10_nvidia_nim_migration_plan_embedding_compatibility", "target": "docs_10_nvidia_nim_migration_plan_nvidiaprovider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:131-141", "weight": 1.0}, {"source": "docs_10_nvidia_nim_migration_plan_embedding_compatibility", "target": "docs_05_ai_engineering_architecture_rag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:267-272", "weight": 1.0}, {"source": "docs_10_nvidia_nim_migration_plan_nvidiaprovider", "target": "docs_05_ai_engineering_architecture_geminiprovider", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:7-8", "weight": 1.0}, {"source": "docs_10_nvidia_nim_migration_plan_model_selection", "target": "docs_05_ai_engineering_architecture_model_config_drift", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md", "source_location": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md:80-82", "weight": 1.0}], "hyperedges": [{"id": "provider_abstraction_pattern", "label": "Pluggable LLM Provider Abstraction (Gemini, Mock, NVIDIA NIM)", "nodes": ["docs_05_ai_engineering_architecture_llmprovider", "docs_05_ai_engineering_architecture_geminiprovider", "docs_05_ai_engineering_architecture_mockprovider", "docs_10_nvidia_nim_migration_plan_nvidiaprovider", "docs_10_nvidia_nim_migration_plan_provider_factory"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/10_NVIDIA_NIM_MIGRATION_PLAN.md"}]}